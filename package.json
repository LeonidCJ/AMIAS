{
  "name": "amias-monorepo",
  "version": "1.0.0",
  "description": "AMIAS Monorepo - NestJS Backend & Next.js 14 Frontend",
  "author": "LeonidCJ",
  "private": true,
  "scripts": {
    "start:backend": "pnpm --filter amias-backend start",
    "dev:backend": "pnpm --filter amias-backend start:dev",
    "dev:frontend": "pnpm --filter amias-frontend dev",
    "build:frontend": "pnpm --filter amias-frontend build",
    "prisma:push": "pnpm --filter amias-backend prisma:push",
    "prisma:generate": "pnpm --filter amias-backend prisma:generate"
  }
}
