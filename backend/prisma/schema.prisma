datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERARIO
  CLIENT
}

enum OrderStatus {
  CONFIRMED
  IN_CUTTING
  DTF_PRINTING
  READY
  COMPLETED
  CANCELLED
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  role              Role         @default(CLIENT)
  customerName      String?
  customerPhone     String?
  preferredCutId    String?
  preferredCut      TextileCut?  @relation(fields: [preferredCutId], references: [id])
  preferredSizeId   String?
  preferredSize     TextileSize? @relation(fields: [preferredSizeId], references: [id])
  deliveryAddress   String?
  deliveryDistrict  String?
  deliveryReference String?
  createdAt         DateTime     @default(now())
  orders            Order[]

  @@map("users")
}

model ConcertEvent {
  id        String    @id @default(uuid())
  name      String
  venue     String
  capacity  Int
  rate      Float     @default(0.004)
  eventDate DateTime
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("concert_events")
}

model TextileCut {
  id               String           @id @default(uuid())
  name             String
  grammageGsm      Int              @default(240)
  description      String?
  createdAt        DateTime         @default(now())
  products         Product[]
  preferredByUsers User[]
  inventoryStocks  InventoryStock[]

  @@map("textile_cuts")
}

model TextileColor {
  id              String           @id @default(uuid())
  name            String
  hexCode         String
  createdAt       DateTime         @default(now())
  inventoryStocks InventoryStock[]

  @@map("textile_colors")
}

model TextileSize {
  id               String           @id @default(uuid())
  label            String
  chestCm          Int
  lengthCm         Int
  shoulderCm       Int
  heightRef        String?
  createdAt        DateTime         @default(now())
  productSizes     ProductSize[]
  orderItems       OrderItem[]
  preferredByUsers User[]
  inventoryStocks  InventoryStock[]

  @@map("textile_sizes")
}

model InventoryStock {
  id        String       @id @default(uuid())
  cutId     String
  cut       TextileCut   @relation(fields: [cutId], references: [id])
  colorId   String
  color     TextileColor @relation(fields: [colorId], references: [id])
  sizeId    String
  size      TextileSize  @relation(fields: [sizeId], references: [id])
  quantity  Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([cutId, colorId, sizeId])
  @@map("inventory_stocks")
}

model Product {
  id             String        @id @default(uuid())
  name           String
  description    String?
  basePrice      Float
  concertEventId String
  concertEvent   ConcertEvent  @relation(fields: [concertEventId], references: [id])
  cutId          String
  cut            TextileCut    @relation(fields: [cutId], references: [id])
  imageUrl       String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sizes          ProductSize[]
  orderItems     OrderItem[]

  @@map("products")
}

model ProductSize {
  productId String
  sizeId    String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      TextileSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@id([productId, sizeId])
  @@map("product_sizes")
}

model Order {
  id             String          @id @default(uuid())
  orderNumber    String          @unique
  customerName   String
  customerPhone  String
  totalAmount    Float
  status         OrderStatus     @default(CONFIRMED)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          OrderItem[]
  paymentReceipt PaymentReceipt?

  @@map("orders")
}

model OrderItem {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  sizeId    String
  size      TextileSize @relation(fields: [sizeId], references: [id])
  quantity  Int
  unitPrice Float

  @@map("order_items")
}

model PaymentReceipt {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operationCode String   @unique
  fileHash      String   @unique
  receiptUrl    String
  createdAt     DateTime @default(now())

  @@map("payment_receipts")
}
